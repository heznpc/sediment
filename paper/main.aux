\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.1.3}Sediment Lifecycle: Deposition, Compaction, Fossilization}{5}{subsubsection.2.1.3}\protected@file@percent }
\newlabel{sec:lifecycle}{{2.1.3}{5}{Sediment Lifecycle: Deposition, Compaction, Fossilization}{subsubsection.2.1.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The Sediment Lifecycle Model. Content produced under streak mechanics progresses through three geological stages. During \emph  {Deposition}, engagement is voluntary and content quality is high. As streak pressure intensifies, \emph  {Compaction} sets in: loss aversion and sunk-cost reasoning transform participation from choice into obligation---the point at which ``the streak owns you'' rather than ``you own the streak'' (dashed line). In \emph  {Fossilization}, the behavior persists as automaticity even as content quality reaches its minimum, and the accumulated record acquires unwarranted social legitimacy as a credentialing signal.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:lifecycle}{{1}{5}{The Sediment Lifecycle Model. Content produced under streak mechanics progresses through three geological stages. During \emph {Deposition}, engagement is voluntary and content quality is high. As streak pressure intensifies, \emph {Compaction} sets in: loss aversion and sunk-cost reasoning transform participation from choice into obligation---the point at which ``the streak owns you'' rather than ``you own the streak'' (dashed line). In \emph {Fossilization}, the behavior persists as automaticity even as content quality reaches its minimum, and the accumulated record acquires unwarranted social legitimacy as a credentialing signal}{figure.1}{}}
